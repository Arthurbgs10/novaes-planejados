# Copie este arquivo para .env.local e preencha com os valores do seu
# projeto Supabase (Project Settings -> API). NUNCA coloque a
# "service_role key" aqui nem em nenhum lugar do código-fonte.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-public-key
